# StudioFlow Supabase Configuration
# Copy to .env.local. The publishable key is safe in browser code; never expose
# the service-role key outside the local seed command or a trusted server.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"
# Use a Supabase Secret key (sb_secret_...) or legacy service_role key here.
# Never put this value in NEXT_PUBLIC_* variables or commit it.
SUPABASE_SERVICE_ROLE_KEY="only_for_node_scripts_seed-studioflow_mjs"
DEMO_EMAIL="demo@studioflow.local"
DEMO_PASSWORD="StudioFlow-demo-2026"

# Legacy Photopholio routes below are not part of the StudioFlow assessment dashboard.
# They remain only as the visual and component foundation for the imported project.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Admin Dashboard Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="secure_password_here"

# ImageKit Configuration for Image Uploads & Optimization
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="your_imagekit_public_key"
IMAGEKIT_PRIVATE_KEY="your_imagekit_private_key"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_imagekit_id"

# Google Drive Picker API (Optional for admin bulk uploads)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id"
NEXT_PUBLIC_GOOGLE_API_KEY="your_google_api_key"

# Database Configuration (Generic SQLite or Postgres)
# If using Postgres, replace this with your actual database URL
DATABASE_URL="file:./dev.db"
