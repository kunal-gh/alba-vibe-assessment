{
  "name": "CoverGuard — Error Report",
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [260, 300],
      "notes": "This workflow receives every unhandled execution failure from the CoverGuard main workflow."
    },
    {
      "parameters": {
        "jsCode": "const execution = $json.execution ?? {};\nconst lastNode = execution.lastNodeExecuted ?? 'unknown node';\nconst error = execution.error ?? $json.error ?? {};\n\nreturn [{\n  json: {\n    occurredAt: new Date().toISOString(),\n    workflow: execution.workflowData?.name ?? 'CoverGuard — Book Cover QA',\n    executionId: execution.id ?? 'unavailable',\n    failedNode: lastNode,\n    message: error.message ?? 'No error message was provided by n8n',\n    status: 'PROCESSING_ERROR'\n  }\n}];"
      },
      "id": "prepare-error-report",
      "name": "Prepare Error Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300],
      "notes": "Normalises n8n error metadata into a concise incident report."
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
          "__rl": true,
          "value": "={{ $env.AIRTABLE_BASE_ID }}",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Workflow Incidents",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Occurred At": "={{ $json.occurredAt }}",
            "Workflow": "={{ $json.workflow }}",
            "Execution ID": "={{ $json.executionId }}",
            "Failed Node": "={{ $json.failedNode }}",
            "Message": "={{ $json.message }}",
            "Status": "={{ $json.status }}"
          }
        }
      },
      "id": "log-workflow-incident",
      "name": "Airtable — Log Workflow Incident",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [740, 300],
      "continueOnFail": true,
      "notes": "Writes a durable, inspectable incident row even if the delivery channel is unavailable."
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.GMAIL_USER }}",
        "toEmail": "={{ $env.COVERGUARD_OPS_EMAIL }}",
        "subject": "[CoverGuard] Workflow failure at {{ $json.failedNode }}",
        "emailType": "text",
        "message": "={{ `CoverGuard failed at ${$json.failedNode}.\\n\\n${$json.message}\\n\\nExecution: ${$json.executionId}\\nTime: ${$json.occurredAt}` }}",
        "options": {}
      },
      "id": "notify-ops",
      "name": "Gmail — Notify Operations",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [980, 300],
      "continueOnFail": true,
      "notes": "Delivers a concise failure notification to the configured operations mailbox."
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [[{ "node": "Prepare Error Report", "type": "main", "index": 0 }]]
    },
    "Prepare Error Report": {
      "main": [[{ "node": "Airtable — Log Workflow Incident", "type": "main", "index": 0 }]]
    },
    "Airtable — Log Workflow Incident": {
      "main": [[{ "node": "Gmail — Notify Operations", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false,
    "instanceId": "coverguard-error-handler"
  },
  "tags": [
    { "id": "tag-coverguard", "name": "CoverGuard AI" },
    { "id": "tag-error-handling", "name": "Error Handling" }
  ]
}
