# Local FastAPI vision service
ENVIRONMENT=demo
GOOGLE_API_KEY=your_google_ai_key_if_used
GEMINI_API_KEY=your_gemini_api_key_if_used

# n8n environment variables. Configure these in n8n, not in a committed file.
COVERGUARD_API_URL=https://your-coverguard-service.example.com
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
GMAIL_USER=your.email@example.com
COVERGUARD_OPS_EMAIL=ops@example.com

# Optional local notification configuration
GMAIL_APP_PASSWORD=your_app_password
SEND_EMAILS=false
